{
  "_version": "1.49.0",
  "sap.app": {
    "id": "retcl.integrationmonitor",
    "type": "application",
    "title": "Integration & Outbox Monitor",
    "description": "Outbox message dispatcher, SAP S/4HANA sync tracking and payload retry monitoring",
    "dataSources": {
      "mainService": {
        "uri": "/billing/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "IntegrationMessagesList",
          "target": "IntegrationMessagesList"
        },
        {
          "pattern": "IntegrationMessages({key}):?query:",
          "name": "IntegrationMessagesObjectPage",
          "target": "IntegrationMessagesObjectPage"
        }
      ],
      "targets": {
        "IntegrationMessagesList": {
          "type": "Component",
          "id": "IntegrationMessagesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "IntegrationMessages",
              "liveMode": true,
              "navigation": {
                "IntegrationMessages": {
                  "detail": {
                    "route": "IntegrationMessagesObjectPage"
                  }
                }
              }
            }
          }
        },
        "IntegrationMessagesObjectPage": {
          "type": "Component",
          "id": "IntegrationMessagesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "IntegrationMessages"
            }
          }
        }
      }
    }
  }
}

{
  "_version": "1.49.0",
  "sap.app": {
    "id": "retcl.managementdashboard",
    "type": "application",
    "title": "Management Dashboard & Fleet Analytics",
    "description": "Executive metrics for billing leakage, equipment utilization, and top damage categories",
    "dataSources": {
      "mainService": {
        "uri": "/analytics/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "FleetOverviewList",
          "target": "FleetOverviewList"
        }
      ],
      "targets": {
        "FleetOverviewList": {
          "type": "Component",
          "id": "FleetOverviewList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "FleetOverview",
              "liveMode": true
            }
          }
        }
      }
    }
  }
}
